# INVENTA — Expiry Tracker · example environment variables
# Copy to ".env" and fill in your own values. NEVER commit your real .env file.

# Database
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<db>

# Auth
JWT_SECRET=change-me-to-a-long-random-string

# Google Gemini AI (server-side only — never expose in frontend code)
GEMINI_API_KEY=your-gemini-api-key
API_KEY=your-gemini-api-key

# Twilio (WhatsApp)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
SHOPKEEPER_WHATSAPP_TO=whatsapp:+92xxxxxxxxxx

# Telegram alerts (optional)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# Email (password reset / verification)
EMAIL_USER=your-email@example.com
EMAIL_PASSWORD=your-email-app-password
SUPPORT_EMAIL=support@example.com

# App
FRONTEND_URL=http://localhost:5173
PORT=5000
NODE_ENV=development
CRON_SECRET=change-me
ENABLE_SCHEDULER_IN_PRODUCTION=false

# Frontend (frontend/.env) — base URL of the backend API only, no secrets
VITE_API_URL=http://localhost:5000
