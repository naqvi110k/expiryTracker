# Git attributes configuration for cross-platform compatibility
# This file ensures consistent behavior across Windows and Ubuntu systems

# Handle line endings automatically
# Text files get platform-appropriate line endings
* text=auto

# Specific file types that should always use LF (Unix-style) line endings
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.css text eol=lf
*.html text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.bash text eol=lf

# Configuration files
*.config text eol=lf
*.conf text eol=lf
.gitignore text eol=lf
.editorconfig text eol=lf

# Package management files
package.json text eol=lf
package-lock.json text eol=lf
yarn.lock text eol=lf
pnpm-lock.yaml text eol=lf

# Documentation files
README.md text eol=lf
LICENSE text eol=lf
*.txt text eol=lf

# Binary files that should not be treated as text
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary

# Node.js specific files
*.node binary

# Database files
*.db binary
*.sqlite binary
*.mdb binary

# Font files
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary

# Archive files
*.tar binary
*.gz binary
*.bz2 binary
*.xz binary
*.rar binary
*.7z binary

# Virtual machine and container files
*.vmdk binary
*.vdi binary
*.qcow2 binary
*.iso binary
*.img binary

# Merge strategies for specific files
package-lock.json merge=ours
yarn.lock merge=ours
pnpm-lock.yaml merge=ours

# Diff settings for specific file types
*.min.js diff=javascript
*.min.css diff=css

# Large files that should use Git LFS (if available)
# Uncomment and configure if using Git LFS
# *.psd filter=lfs diff=lfs merge=lfs -text
# *.ai filter=lfs diff=lfs merge=lfs -text